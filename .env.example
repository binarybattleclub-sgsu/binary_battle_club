# ==============================================================================
# BINARY BATTLE CLUB — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Apps Script Web App Deployment URL
# Deploy google-apps-script/Code.gs as a Web App in your Google Spreadsheet
# and paste the resulting Web App URL below:
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: Shared secret token (leave empty if not configured in Script Properties)
GOOGLE_APPS_SCRIPT_SECRET=
